{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "npm run build --workspace @workspace/orca-web && npm run build --workspace @workspace/api-server",
    "start": "node --env-file-if-exists=.env artifacts/api-server/dist/index.mjs",
    "test": "npm test --workspace @workspace/api-server",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present",
    "typecheck:libs": "tsc --build",
    "test:live": "npm run test:live --workspace @workspace/api-server"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ]
}
