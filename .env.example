# Copy to .env (git-ignored). The API loads it with --env-file-if-exists.

# Required: the language model that interprets questions, plans tool calls and writes answers.
GEMINI_API_KEY=

# Preferred model. If it is over quota or overloaded the agent falls back through a fixed list of other Gemini models.
ORCA_MODEL=gemini-flash-latest

# Optional
# PORT=8080                          # API port (required by the server; set on the command line if not here)
# ORCA_DB=./data/orca.db             # SQLite file for accounts, saved locations and conversations
# WEB_DIST=../orca-web/dist/public   # built web app to serve from the API process
# ORCA_BLOCK_HOSTS=sachet.ndma.gov.in  # failure drill: make these upstream hosts fail, to show graceful degradation
